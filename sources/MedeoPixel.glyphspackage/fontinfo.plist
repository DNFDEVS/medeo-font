# a contour tone after the first mark of a capital stack takes its stack form too, so the stack stays under the Windows ascent
lookup ccmp_cap_stack_tone {
	@CapStackTone = [macronacutecomb gravemacroncomb macrongravecomb acutemacroncomb];
	@CapStackToneStack = [macronacutecomb.stack gravemacroncomb.stack macrongravecomb.stack acutemacroncomb.stack];
	@CapStackAfter = [@CapStackMarkStack @CapStackTone];
	lookupflag UseMarkFilteringSet @CapStackAfter;
	sub @CapStackBase @CapStackMarkStack @CapStackTone' by @CapStackToneStack;
	sub [Iacute.stack Icircumflex.stack Idieresis.stack Idotaccent.stack Igrave.stack Imacron.stack Itilde.stack Icaron.stack Ibreve.stack Ihookabove.stack Yi-cy.stack] @CapStackTone' by @CapStackToneStack;
} ccmp_cap_stack_tone;

